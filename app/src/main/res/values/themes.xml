<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Set Material roles as well as custom roles so default controls share the palette. -->
    <style name="Base.Theme.NewsMead.Palette" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/palette_primary</item>
        <item name="colorOnPrimary">@color/palette_on_primary</item>
        <item name="colorPrimaryContainer">@color/palette_soft</item>
        <item name="colorOnPrimaryContainer">@color/palette_on_soft</item>
        <item name="colorSecondary">@color/palette_action</item>
        <item name="colorOnSecondary">@color/palette_on_action</item>
        <item name="colorSecondaryContainer">@color/palette_soft</item>
        <item name="colorOnSecondaryContainer">@color/palette_on_soft</item>
        <item name="colorTertiary">@color/palette_action</item>
        <item name="colorOnTertiary">@color/palette_on_action</item>
        <item name="colorTertiaryContainer">@color/palette_soft</item>
        <item name="colorOnTertiaryContainer">@color/palette_on_soft</item>
        <item name="android:colorBackground">@color/palette_background</item>
        <item name="colorOnBackground">@color/palette_on_surface</item>
        <item name="colorSurface">@color/palette_surface</item>
        <item name="colorOnSurface">@color/palette_on_surface</item>
        <item name="colorSurfaceVariant">@color/palette_surface_variant</item>
        <item name="colorSurfaceBright">@color/palette_surface</item>
        <item name="colorSurfaceDim">@color/palette_surface_variant</item>
        <item name="colorSurfaceContainer">@color/palette_surface</item>
        <item name="colorSurfaceContainerLow">@color/palette_background</item>
        <item name="colorSurfaceContainerHigh">@color/palette_surface_variant</item>
        <item name="colorSurfaceContainerLowest">@color/palette_surface</item>
        <item name="colorSurfaceContainerHighest">@color/palette_surface_variant</item>
        <item name="colorOnSurfaceVariant">@color/palette_muted</item>
        <item name="colorSurfaceInverse">@color/palette_inverse_surface</item>
        <item name="colorOnSurfaceInverse">@color/palette_on_inverse_surface</item>
        <item name="colorPrimaryInverse">@color/palette_inverse_primary</item>
        <item name="colorOutline">@color/palette_outline_strong</item>
        <item name="colorOutlineVariant">@color/palette_outline</item>
        <item name="colorAccent">@color/palette_action</item>
        <item name="colorControlActivated">@color/palette_primary</item>
        <item name="colorControlNormal">@color/palette_muted</item>
        <item name="colorControlHighlight">@color/palette_ripple</item>
        <item name="android:statusBarColor">@color/palette_background</item>
        <item name="android:navigationBarColor">@color/palette_background</item>
        <item name="android:textColorPrimary">@color/palette_text_primary</item>
        <item name="android:textColorSecondary">@color/palette_text_secondary</item>
        <item name="android:textColorTertiary">@color/palette_text_secondary</item>
        <item name="android:textColorPrimaryDisableOnly">@color/palette_text_primary</item>
        <item name="android:textColorHint">@color/palette_text_secondary</item>
        <item name="android:textColorAlertDialogListItem">@color/palette_text_primary</item>
        <item name="android:textColorPrimaryInverse">@color/palette_text_inverse</item>
        <item name="android:textColorSecondaryInverse">@color/palette_text_inverse</item>
        <item name="android:textColorTertiaryInverse">@color/palette_text_inverse</item>
        <item name="android:textColorPrimaryInverseDisableOnly">@color/palette_text_inverse</item>
        <item name="android:textColorHintInverse">@color/palette_text_inverse</item>
        <item name="android:textColorLink">@color/palette_action</item>
        <item name="android:textColorLinkInverse">@color/palette_inverse_primary</item>
        <item name="android:textColorHighlight">@color/palette_soft</item>
    </style>

    <!-- Base application theme. -->
    <style name="Base.Theme.NewsMead" parent="Base.Theme.NewsMead.Palette">
        <!-- Customize your light theme here. -->
        <!-- Notification bar -->
        <item name="colorPrimaryDark">@color/palette_background</item> <!-- NOTE: Refer to primaryBackgroundColor -->
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>

        <!-- Application colors -->
        <item name="primaryTextColor">@color/palette_on_surface</item>
        <item name="secondaryTextColor">@color/palette_muted</item>

        <item name="primaryBackgroundColor">@color/palette_background</item>
        <item name="transparentColor">@color/transparent</item>

        <item name="primaryIconColor">@color/palette_on_surface</item>
        <item name="secondaryIconColor">@color/palette_muted</item>

        <item name="primaryButtonTextColor">@color/palette_on_primary</item>
        <item name="primaryButtonBgColor">@color/palette_primary</item>
        <item name="primaryButtonRippleColor">@color/palette_primary_ripple</item>

        <item name="secondaryButtonTextColor">@color/palette_on_soft</item>
        <item name="secondaryButtonBgColor">@color/palette_soft</item>
        <item name="secondaryButtonIconColor">@color/palette_on_soft</item>

        <item name="dividerColor">@color/palette_outline</item>
        <item name="shimmerColor">@color/palette_control_off</item>
        <item name="cardBackgroundColor">@color/palette_surface</item>
        <item name="cardBackgroundColorPrimary">@color/palette_soft</item>

        <!--component colors-->
        <item name="lowEmphasisColor">@color/palette_soft</item>
        <item name="midEmphasisColor">@color/palette_soft</item>
        <item name="highEmphasisColor">@color/palette_primary</item>

        <item name="lowBackground">@color/palette_surface_variant</item>
        <item name="midBackground">@color/palette_background</item>
        <item name="highBackground">@color/palette_on_surface</item>

        <item name="lowTextEmphasis">@color/palette_muted</item>
        <item name="highTextEmphasis">@color/palette_action</item>

        <item name="iconColorDefault">@color/palette_muted</item>
        <item name="iconColorStar">@color/palette_action</item>

        <item name="buttonRippleGold">@color/palette_ripple</item>
        <item name="buttonRippleCobalt">@color/palette_ripple</item>
        <item name="buttonRippleGray">@color/palette_ripple</item>

        <item name="navBarColor">@color/palette_background</item>
        <item name="navBarIconColor">@color/palette_on_surface</item>
        <item name="navBarTextColor">@color/palette_on_surface</item>
        <item name="navBarIndicatorColor">@color/palette_soft</item>

        <item name="listReadLaterBackground">@color/palette_soft</item>
        <item name="listOfflineBackground">@color/palette_surface</item>
        <item name="listReadLaterStroke">@color/palette_outline_strong</item>
        <item name="listOfflineStroke">@color/palette_outline</item>
        <item name="listDefaultStroke">@color/palette_outline</item>
        <item name="listNumTextColor">@color/palette_muted</item>

        <item name="tabIndicatorColor">@color/palette_action</item>
        <item name="tabSelectedTextColor">@color/palette_action</item>
        <item name="tabTextColor">@color/palette_muted</item>

        <item name="titleColor">@color/palette_action</item>

    </style>

    <style name="Theme.NewsMead" parent="Base.Theme.NewsMead" />

    <style name="Theme.NewsMead.Circular">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <style name="BottomNavigationView" parent="@style/TextAppearance.AppCompat.Caption">
        <item name="android:textSize">16sp</item>
    </style>

    <style name="Theme.App.SplashScreen" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/palette_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/sample_newsmead_logo</item>
        <item name="postSplashScreenTheme">@style/Theme.NewsMead</item>
    </style>

    <!-- Button Style -->
    <style name="ButtonOverlay">
        <item name="fontFamily">@font/arial_regular</item>
        <item name="textAllCaps">false</item>
        <item name="cornerRadius">24dp</item>
        <item name="elevation">0dp</item>
        <item name="android:translationZ">0dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="ButtonOverlayGray" parent="ButtonOverlay">
        <item name="colorPrimary">?primaryButtonBgColor</item>
        <item name="colorOnPrimary">?primaryButtonTextColor</item>
        <item name="rippleColor">?primaryButtonRippleColor</item>
    </style>

    <style name="ButtonOverlayWhite" parent="ButtonOverlay">
        <item name="colorPrimary">?secondaryButtonBgColor</item>
        <item name="colorOnPrimary">?secondaryButtonTextColor</item>
        <item name="rippleColor">?secondaryButtonBgColor</item>
    </style>

    <!--    Button themes   -->

    <style name="ButtonSmall_LowEmphasis" parent="ts_button_medium">
        <item name="android:backgroundTint">?lowEmphasisColor</item>
        <item name="android:textColor">?secondaryButtonTextColor</item>
        <item name="rippleColor">?buttonRippleGold</item>
        <!--Padding-->
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:paddingBottom">12dp</item>
    </style>

    <style name="ButtonSmall_HighEmphasis" parent="ts_button_large">
        <item name="android:backgroundTint">?highEmphasisColor</item>
        <item name="android:textColor">?primaryButtonTextColor</item>
        <item name="iconTint">?primaryButtonTextColor</item>
        <item name="rippleColor">?primaryButtonRippleColor</item>
        <!--Padding-->
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:paddingBottom">12dp</item>
    </style>

    <style name="ButtonSquare_MidEmphasis" parent="ts_subtext_regular">
        <item name="android:backgroundTint">?midEmphasisColor</item>
        <item name="android:textColor">?secondaryButtonTextColor</item>
        <item name="rippleColor">?buttonRippleGold</item>
        <!--Padding-->
        <item name="android:padding">8dp</item>
        <item name="android:paddingLeft">8dp</item>
        <item name="android:paddingRight">8dp</item>
    </style>

    <style name="ButtonSquare_MidEmphasis.Smaller" parent="ButtonSquare_MidEmphasis">
        <item name="android:backgroundTint">?lowEmphasisColor</item>
    </style>

    <style name="ButtonSquare_MidEmphasis.BGMode" parent="ButtonSquare_MidEmphasis">
        <item name="android:backgroundTint">?transparentColor</item>
        <item name="android:minWidth">48dip</item>
        <item name="android:width">55dip</item>
        <item name="android:textColor">?secondaryTextColor</item>
    </style>

    <style name="ButtonMedium_Solid" parent="ts_button_large">
        <item name="android:backgroundTint">?highEmphasisColor</item>
        <item name="android:textColor">?primaryButtonTextColor</item>
        <item name="iconTint">?primaryButtonTextColor</item>
        <item name="rippleColor">?primaryButtonRippleColor</item>
        <!--Padding-->
        <item name="android:paddingTop">14dp</item>
        <item name="android:paddingBottom">14dp</item>
    </style>

    <style name="ButtonMedium_Text" parent="ButtonMedium_Solid">
        <item name="android:backgroundTint">?midBackground</item>
        <item name="android:textColor">?highTextEmphasis</item>
        <item name="iconTint">?highTextEmphasis</item>
        <item name="rippleColor">?buttonRippleGray</item>
    </style>

    <!--    Chip style  -->
    <style name="ChipStyle" parent="@style/Widget.MaterialComponents.Chip.Choice">
        <item name="chipBackgroundColor">@color/chip_background_color</item>
        <item name="android:textColor">@color/chip_text_color</item>

        <item name="android:fontFamily">@font/arial_regular</item>
        <item name="android:textSize">@dimen/text_size_18</item>
        <item name="android:lineSpacingExtra">1sp</item>
        <item name="android:lineSpacingMultiplier">1.4</item>
    </style>

    <!--    List card style  -->
    <style name="ListCardStyle.Default" parent="@style/Widget.MaterialComponents.CardView">
        <item name="cardBackgroundColor">?primaryBackgroundColor</item>
        <item name="cardCornerRadius">20dp</item>
        <item name="rippleColor">?buttonRippleGold</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">?listDefaultStroke</item>
    </style>

    <style name="ListCardStyle.ReadLater" parent="ListCardStyle.Default">
        <item name="cardBackgroundColor">?listReadLaterBackground</item>
        <item name="strokeColor">?listReadLaterStroke</item>
    </style>

    <style name="ListCardStyle.Offline" parent="ListCardStyle.Default">
        <item name="cardBackgroundColor">?listOfflineBackground</item>
        <item name="strokeColor">?listOfflineStroke</item>
    </style>


    <!-- Text Field Style -->
    <style name="EditTextOverlay">
        <item name="fontFamily">@font/arial_regular</item>
        <item name="boxBackgroundColor">?primaryBackgroundColor</item>
    </style>

    <!-- Material Override-->
    <style name="Widget.App.ButtonStyle.Cobalt" parent="Widget.MaterialComponents.Button.UnelevatedButton">
        <item name="materialThemeOverlay">@style/ButtonMedium_Solid</item>
    </style>

    <style name="Widget.App.ButtonStyle.Gray" parent="Widget.MaterialComponents.Button.UnelevatedButton">
        <item name="materialThemeOverlay">@style/ButtonOverlayGray</item>
    </style>

    <style name="Widget.App.ButtonStyle.White" parent="Widget.MaterialComponents.Button.UnelevatedButton">
        <item name="materialThemeOverlay">@style/ButtonOverlayWhite</item>
    </style>

    <style name="Widget.App.TextInputLayout.FilledBox" parent="Widget.Material3.TextInputLayout.FilledBox">
        <item name="fontFamily">@font/arial_regular</item>
        <item name="boxBackgroundColor">?primaryBackgroundColor</item>
    </style>

    <style name="Widget.App.BottomNavigationView.ActiveIndicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">?navBarIndicatorColor</item>
    </style>



</resources>
