<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/pilotRoot" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="?primaryBackgroundColor">
    <LinearLayout android:layout_width="match_parent" android:layout_height="48dp" android:gravity="center_vertical">
        <Button android:id="@+id/pilotBack" android:layout_width="72dp" android:layout_height="match_parent"
            android:paddingHorizontal="8dp" android:minWidth="0dp" android:maxLines="1" android:textSize="14sp" android:text="@string/scanpath_replay_back" />
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:text="@string/scanpath_pilot_title" android:textSize="20sp" android:textColor="?primaryTextColor" />
        <Button android:id="@+id/pilotSettings" android:layout_width="100dp" android:layout_height="match_parent"
            android:paddingHorizontal="8dp" android:minWidth="0dp" android:maxLines="1" android:textSize="14sp" android:text="@string/scanpath_pilot_settings" />
    </LinearLayout>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingHorizontal="16dp"
        android:text="@string/scanpath_pilot_notice" android:textSize="13sp" android:textColor="?primaryTextColor" />
    <Spinner android:id="@+id/pilotTask" android:layout_width="match_parent" android:layout_height="48dp" />
    <Spinner android:id="@+id/pilotPassage" android:layout_width="match_parent" android:layout_height="48dp" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="48dp">
        <Button android:id="@+id/pilotStart" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="@string/scanpath_pilot_start" />
        <Button android:id="@+id/pilotStop" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="@string/scanpath_replay_stop" />
        <Button android:id="@+id/pilotTrace" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="@string/scanpath_replay_save" />
    </LinearLayout>
    <TextView android:id="@+id/pilotStatus" android:layout_width="match_parent" android:layout_height="90dp" android:paddingHorizontal="16dp"
        android:gravity="center_vertical" android:textSize="13sp" android:textColor="?primaryTextColor" android:maxLines="4" android:text="@string/scanpath_pilot_ready" />
    <!-- Current definitions use the text viewport; no magnifier strip in any condition. -->
    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:visibility="gone">
        <com.newsmead.gaze.aid.ReadingAidWordView android:id="@+id/pilotWordDock" android:layout_width="match_parent"
            android:layout_height="match_parent" android:paddingHorizontal="16dp" android:paddingVertical="10dp" android:gravity="center" android:singleLine="true" android:textColor="?primaryTextColor" />
    </FrameLayout>
    <FrameLayout android:id="@+id/pilotViewport" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <androidx.core.widget.NestedScrollView android:id="@+id/pilotScroll" android:layout_width="match_parent" android:layout_height="match_parent">
            <TextView android:id="@+id/pilotBody" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="16dp"
                android:fontFamily="@font/arial_regular" android:textColor="?primaryTextColor" android:lineSpacingExtra="2dp" />
        </androidx.core.widget.NestedScrollView>
    </FrameLayout>
</LinearLayout>
