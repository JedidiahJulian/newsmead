<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.NewsMead" parent="Base.Theme.NewsMead.Palette">
        <!-- Customize your dark theme here. -->
        <!-- Notification bar -->
        <item name="colorPrimaryDark">@color/palette_background</item> <!-- NOTE: Refer to primaryBackgroundColor -->
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>

        <!-- Application colors -->
        <item name="primaryTextColor">@color/palette_on_surface</item>
        <item name="secondaryTextColor">@color/palette_muted</item>

        <item name="primaryBackgroundColor">@color/palette_background</item>
        <item name="transparentColor">@color/transparent</item>

        <item name="primaryIconColor">@color/palette_on_surface</item>
        <item name="secondaryIconColor">@color/palette_muted</item>

        <item name="primaryButtonTextColor">@color/palette_on_primary</item>
        <item name="primaryButtonBgColor">@color/palette_primary</item>
        <item name="primaryButtonRippleColor">@color/palette_primary_ripple</item>

        <item name="secondaryButtonTextColor">@color/palette_on_soft</item>
        <item name="secondaryButtonBgColor">@color/palette_soft</item>
        <item name="secondaryButtonIconColor">@color/palette_on_soft</item>

        <item name="dividerColor">@color/palette_outline</item>
        <item name="shimmerColor">@color/palette_control_off</item>
        <item name="cardBackgroundColor">@color/palette_surface</item>
        <item name="cardBackgroundColorPrimary">@color/palette_soft</item>

        <!--component colors-->
        <item name="lowEmphasisColor">@color/palette_soft</item>
        <item name="midEmphasisColor">@color/palette_soft</item>
        <item name="highEmphasisColor">@color/palette_primary</item>

        <item name="lowBackground">@color/palette_surface_variant</item>
        <item name="midBackground">@color/palette_background</item>
        <item name="highBackground">@color/palette_on_surface</item>

        <item name="lowTextEmphasis">@color/palette_muted</item>
        <item name="highTextEmphasis">@color/palette_action</item>

        <item name="iconColorDefault">@color/palette_muted</item>
        <item name="iconColorStar">@color/palette_action</item>

        <item name="buttonRippleGold">@color/palette_ripple</item>
        <item name="buttonRippleCobalt">@color/palette_ripple</item>
        <item name="buttonRippleGray">@color/palette_ripple</item>

        <item name="navBarColor">@color/palette_background</item>
        <item name="navBarIconColor">@color/palette_on_surface</item>
        <item name="navBarTextColor">@color/palette_on_surface</item>
        <item name="navBarIndicatorColor">@color/palette_soft</item>

        <item name="listReadLaterBackground">@color/palette_soft</item>
        <item name="listOfflineBackground">@color/palette_surface</item>
        <item name="listReadLaterStroke">@color/palette_outline_strong</item>
        <item name="listOfflineStroke">@color/palette_outline</item>
        <item name="listDefaultStroke">@color/palette_outline</item>
        <item name="listNumTextColor">@color/palette_muted</item>

        <item name="tabIndicatorColor">@color/palette_action</item>
        <item name="tabSelectedTextColor">@color/palette_action</item>
        <item name="tabTextColor">@color/palette_muted</item>

        <item name="titleColor">@color/palette_action</item>

    </style>

    <!--    Button themes   -->

    <style name="ButtonSmall_LowEmphasis" parent="ts_button_medium">
        <item name="android:backgroundTint">?lowEmphasisColor</item>
        <item name="android:textColor">?secondaryButtonTextColor</item>
        <item name="rippleColor">?buttonRippleGold</item>
        <!--Padding-->
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:paddingBottom">12dp</item>
    </style>

    <style name="ButtonSmall_HighEmphasis" parent="ts_button_large">
        <item name="android:backgroundTint">?highEmphasisColor</item>
        <item name="android:textColor">?primaryButtonTextColor</item>
        <item name="iconTint">?primaryButtonTextColor</item>
        <item name="rippleColor">?primaryButtonRippleColor</item>
        <!--Padding-->
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:paddingBottom">12dp</item>
    </style>

    <style name="ButtonSquare_MidEmphasis" parent="ts_subtext_regular">
        <item name="android:backgroundTint">?midEmphasisColor</item>
        <item name="android:textColor">?secondaryButtonTextColor</item>
        <item name="rippleColor">?buttonRippleGold</item>
        <!--Padding-->
        <item name="android:padding">8dp</item>
        <item name="android:paddingLeft">8dp</item>
        <item name="android:paddingRight">8dp</item>
    </style>

    <style name="ButtonSquare_MidEmphasis.Smaller" parent="ButtonSquare_MidEmphasis">
        <item name="android:backgroundTint">?lowEmphasisColor</item>
    </style>

    <style name="ButtonSquare_MidEmphasis.BGMode" parent="ButtonSquare_MidEmphasis">
        <item name="android:backgroundTint">?transparentColor</item>
        <item name="android:minWidth">48dip</item>
        <item name="android:width">55dip</item>
        <item name="android:textColor">?secondaryTextColor</item>
    </style>

    <style name="ButtonMedium_Solid" parent="ts_button_large">
        <item name="android:backgroundTint">?highEmphasisColor</item>
        <item name="android:textColor">?primaryButtonTextColor</item>
        <item name="iconTint">?primaryButtonTextColor</item>
        <item name="rippleColor">?primaryButtonRippleColor</item>
        <!--Padding-->
        <item name="android:paddingTop">14dp</item>
        <item name="android:paddingBottom">14dp</item>
    </style>

    <style name="ButtonMedium_Text" parent="ButtonMedium_Solid">
        <item name="android:backgroundTint">?midBackground</item>
        <item name="android:textColor">?highTextEmphasis</item>
        <item name="iconTint">?highTextEmphasis</item>
        <item name="rippleColor">?buttonRippleGray</item>
    </style>

    <!--    List card style  -->
    <style name="ListCardStyle.Default" parent="@style/Widget.MaterialComponents.CardView">
        <item name="cardBackgroundColor">?primaryBackgroundColor</item>
        <item name="cardCornerRadius">20dp</item>
        <item name="rippleColor">?buttonRippleGold</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">?listDefaultStroke</item>
    </style>

    <style name="ListCardStyle.ReadLater" parent="ListCardStyle.Default">
        <item name="cardBackgroundColor">?listReadLaterBackground</item>
        <item name="strokeColor">?listReadLaterStroke</item>
    </style>

    <style name="ListCardStyle.Offline" parent="ListCardStyle.Default">
        <item name="cardBackgroundColor">?listOfflineBackground</item>
        <item name="strokeColor">?listOfflineStroke</item>
    </style>

    <style name="Widget.App.BottomNavigationView.ActiveIndicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">?navBarIndicatorColor</item>
    </style>


</resources>